  doi = {10.1063/1.857970},
  summary = {Discusses the small deformation scale regime (kd » 1) of the shallow water QG equation. Important features of this regime are: (1) Dynamics evolve on a slower time scale -— t   kd², (2) Introduces an asymptotic model - which is independent of kd (eq 4) whose solution agrees well with the solution of the full system (see fig. 4). Thus for kd »1, the solution of the system is independent of kd and affects only the time scale, (3) Coherent vortices that arise are separated by smaller distances than in the 2D vorticity dynamics. There are also a lot of coherent vortices and therefore the whole system is not sparse, which is the case in 2D vorticity dynamics (compare fig 11b and fig 13). (4) Vortex merger events result in less filamentation as compared to 2DV. This is because filamentation is a process by which finer scales form, leading to enstrophy dissipation. Enstrophy dissipation becomes less effective as kd is increased (see fig 8).},
  summary = {Discusses the small deformation scale regime (kd » 1) of the shallow water QG equation. Important features of this regime are: (1) Dynamics evolve on a slower time scale -— t   kd², (2) Introduces an asymptotic model - which is independent of kd (eq 4) whose solution agrees well with the solution of the full system (see fig. 4). Thus for kd »1, the solution of the system is independent of kd and affects only the time scale, (3) Coherent vortices that arise are separated by smaller distances than in the 2D vorticity dynamics. There are also a lot of coherent vortices and therefore the whole system is not sparse, which is the case in 2D vorticity dynamics (compare fig 11b and fig 13). (4) Vortex merger events result in less filamentation as compared to 2DV. This is because filamentation is a process by which finer scales form, leading to enstrophy dissipation. Enstrophy dissipation becomes less effective as kd is increased (see fig 8).}
}
